# Caddy gets and renews the HTTPS certificates by itself (DNS must point at this server first).
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 15MB
	}
}

# Admin app + FieldOps owner's console (/platform)
app.{$DOMAIN} {
	import common
	# API straight to the admin backend (actuator and swagger stay internal: only /api/* is routed).
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy frontend:80
	}
}

# Customer portal: company pages at /{slug}
{$DOMAIN} {
	import common
	handle /api/* {
		reverse_proxy portal-backend:8090
	}
	handle {
		reverse_proxy portal-frontend:80
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
