# Copy to deploy/.env on the server and fill in. Never commit deploy/.env (.gitignore covers it).
# Generate secrets on the server with the commands shown.

# Your domain, without www or app. DNS: A records for @, www and app → the server's public IP.
DOMAIN=example.sa
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=you@example.com

# openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# openssl rand -base64 48      (admin staff tokens)
JWT_SECRET=
# openssl rand -base64 48      (customer tokens — MUST differ from JWT_SECRET)
PORTAL_JWT_SECRET=
# openssl rand -base64 32      (encrypts WhatsApp/SMS secrets saved in Platform → Settings; never change it later)
SETTINGS_ENCRYPTION_KEY=

# The FieldOps owner's console account, created on the first start only
PLATFORM_ADMIN_PHONE=05XXXXXXXX
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME="FieldOps Admin"
PLATFORM_ADMIN_EMAIL=

# Optional
GOOGLE_PLACES_API_KEY=
LIMITED_WHATSAPP_MONTHLY=100

# Backups (deploy/backup.sh). rclone remote:folder for off-server copies; empty = local only.
#   Hetzner Storage Box: storagebox:fieldops-backups    Oracle Object Storage: oci:fieldops-backups
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
