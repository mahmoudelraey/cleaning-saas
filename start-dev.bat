@echo off
echo [1/5] Starting PostgreSQL in Docker...
docker compose up -d db || (echo Docker failed - is Docker Desktop running? & pause & exit /b 1)
echo [2/5] Starting admin backend on http://localhost:8080 ...
start "FieldOps admin backend" cmd /k "cd /d %~dp0admin\backend && mvn spring-boot:run -Dspring-boot.run.profiles=local"
echo [3/5] Starting admin frontend on http://localhost:4200 ...
start "FieldOps admin frontend" cmd /k "cd /d %~dp0admin\frontend && (if not exist node_modules npm install) && npm start"
echo [4/5] Starting portal backend on http://localhost:8090 ...
start "FieldOps portal backend" cmd /k "cd /d %~dp0portal\backend && mvn spring-boot:run -Dspring-boot.run.profiles=local"
echo [5/5] Starting portal frontend on http://localhost:4300 ...
start "FieldOps portal frontend" cmd /k "cd /d %~dp0portal\frontend && (if not exist node_modules npx -y -p node@24.22.0 -p npm@10 -- npm install) && npm start"
echo.
echo Admin:  http://localhost:4200/signup
echo Portal: http://localhost:4300/p/YOUR-COMPANY-SLUG   (the slug is in Settings, booking link)
timeout /t 15
