<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Backend build for the whole repository:
        core            shared domain (entities, repositories, business services) - a plain jar
        admin/backend   admin API (owns the DB schema with Flyway, runs the background jobs)
        portal/backend  customer portal API
      Both apps use the same database and the same core code.
      Build everything: mvn verify       One app: mvn -pl admin/backend -am verify
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.fieldops</groupId>
    <artifactId>fieldops-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fieldops-parent</name>

    <modules>
        <module>core</module>
        <module>admin/backend</module>
        <module>portal/backend</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.9</springdoc.version>
        <aws-sdk.version>2.28.0</aws-sdk.version>
        <shedlock.version>5.16.0</shedlock.version>
        <openpdf.version>2.0.3</openpdf.version>
        <zxing.version>3.5.3</zxing.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fieldops</groupId>
                <artifactId>fieldops-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
