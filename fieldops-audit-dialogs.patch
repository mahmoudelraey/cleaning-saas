@@ -0,0 +1,35 @@
+<app-dialog [(visible)]="visible" [title]="title()" [subtitle]="subtitle()" [icon]="icon()" [width]="width()" [dismissable]="true">
+  <div class="fo-dlg-body">
+    @if (fields().length) {
+      <div class="fo-details">
+        @for (f of fields(); track $index) {
+          <div class="fo-detail" [class.full]="f.full || f.kind === 'multiline'">
+            <small>{{ f.label | translate }}</small>
+            @if (isEmpty(f) && f.kind !== 'status') {
+              <span class="fo-muted">—</span>
+            } @else {
+              @switch (f.kind) {
+                @case ('money') { <b class="ltr">{{ +f.value! | sar }}</b> }
+                @case ('date') { <b>{{ '' + f.value | ldate: 'dayMonthYear' }}</b> }
+                @case ('datetime') { <b>{{ '' + f.value | ldate: 'medium' }}</b> }
+                @case ('phone') { <b class="ltr">{{ '' + f.value | phone }}</b> }
+                @case ('ltr') { <b class="ltr">{{ f.value }}</b> }
+                @case ('status') { <span class="fo-pill" [class.off]="!f.on">{{ '' + f.value }}</span> }
+                @case ('multiline') { <p class="fo-multiline">{{ f.value }}</p> }
+                @default { <b>{{ f.value }}</b> }
+              }
+            }
+          </div>
+        }
+      </div>
+    }
+    <ng-content />
+    <app-audit-block [audit]="audit()" />
+  </div>
+  <div class="fo-dlg-foot">
+    @if (canEdit()) {
+      <p-button [icon]="editIcon()" [label]="editLabel() | translate" (onClick)="onEdit()" />
+    }
+    <p-button [label]="'common.close' | translate" severity="secondary" [outlined]="true" (onClick)="visible.set(false)" />
+  </div>
+</app-dialog>
diff --git a/frontend/admin/src/app/shared/details-dialog/details-dialog.ts b/frontend/admin/src/app/shared/details-dialog/details-dialog.ts
new file mode 100644
index 0000000..9bcb5de
--- /dev/null
+++ b/frontend/admin/src/app/shared/details-dialog/details-dialog.ts
@@ -0,0 +1,54 @@
+import { Component, input, model, output } from '@angular/core';
+import { TranslatePipe } from '@ngx-translate/core';
+import { Button } from 'primeng/button';
+
+import { AuditInfo } from '../../core/api.types';
+import { PhonePipe, SarPipe } from '../format';
+import { LocalDatePipe } from '../local-date.pipe';
+import { AppDialog } from '../dialog/dialog';
+import { AuditBlock } from './audit-block';
+
+/** One read-only value in the details dialog; {@code label} is a translation key. */
+export interface DetailField {
+  label: string;
+  value?: string | number | boolean | null;
+  /** How to show the value (default text). */
+  kind?: 'text' | 'money' | 'date' | 'datetime' | 'phone' | 'status' | 'multiline' | 'ltr';
+  /** status: green when true / given, grey otherwise. */
+  on?: boolean;
+  /** Spans the whole row (long text). */
+  full?: boolean;
+}
+
+/**
+ * Read-only details of a record: value tiles, optional extra sections (projected), and who created / last changed
+ * it. Every list page opens it from the eye button in the table.
+ */
+@Component({
+  selector: 'app-details-dialog',
+  imports: [AppDialog, AuditBlock, Button, TranslatePipe, SarPipe, PhonePipe, LocalDatePipe],
+  templateUrl: './details-dialog.html',
+})
+export class DetailsDialog {
+  readonly visible = model(false);
+  readonly title = input<string>('');
+  readonly subtitle = input<string | null | undefined>(null);
+  readonly icon = input<string>('pi pi-eye');
+  readonly fields = input<DetailField[]>([]);
+  readonly audit = input<AuditInfo | null | undefined>(null);
+  readonly canEdit = input(false);
+  /** The main button's label (translation key) and icon: "Edit" by default, e.g. "Open" for records with a page. */
+  readonly editLabel = input('common.edit');
+  readonly editIcon = input('pi pi-pencil');
+  readonly width = input('980px');
+  readonly edit = output<void>();
+
+  protected isEmpty(f: DetailField): boolean {
+    return f.value === null || f.value === undefined || f.value === '';
+  }
+
+  protected onEdit(): void {
+    this.visible.set(false);
+    this.edit.emit();
+  }
+}
