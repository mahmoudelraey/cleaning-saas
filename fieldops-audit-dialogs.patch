+
+// ---------- Dialog frame (shared/dialog) and details dialog (shared/details-dialog) ----------
+// Header and footer stay put; only .fo-dlg-body scrolls (one scrollbar). Same look as the services dialog.
+.p-dialog.fo-dialog {
+  border-radius: 22px;
+  overflow: hidden;
+  max-height: calc(100vh - 2rem);
+  .p-dialog-content { padding: 0; overflow: hidden; display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
+}
+.fo-dlg, .fo-dlg-form { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; max-height: calc(100vh - 2rem); }
+.fo-dlg-head {
+  display: flex; align-items: center; gap: 1rem; flex: none;
+  padding: 1.1rem 1.5rem; border-bottom: 1px solid var(--fo-border); background: var(--fo-surface);
+  .fo-dlg-ico {
+    width: 52px; height: 52px; flex: none; border-radius: 50%; display: grid; place-items: center;
+    background: var(--brand-92); color: var(--brand-26);
+    i { font-size: 1.35rem; }
+  }
+  .fo-dlg-title { flex: 1; min-width: 0; }
+  h2 { margin: 0; font-size: 1.25rem; font-weight: 800; color: var(--fo-text); }
+  p { margin: .2rem 0 0; color: var(--fo-muted); font-size: .85rem; }
+}
+.fo-dlg-close {
+  width: 40px; height: 40px; flex: none; border: 0; border-radius: 50%; background: transparent; cursor: pointer; color: var(--slate-27);
+  &:hover { background: var(--slate-96); }
+}
+.fo-dlg-body {
+  flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 1.25rem 1.5rem;
+  display: flex; flex-direction: column; gap: 1rem; background: var(--fo-surface);
+}
+.fo-dlg-foot {
+  display: flex; align-items: center; justify-content: flex-end; gap: .6rem; flex-wrap: wrap; flex: none;
+  padding: 1rem 1.5rem; border-top: 1px solid var(--fo-border); background: var(--fo-surface);
+  .start { margin-inline-end: auto; }
+  .p-button { border-radius: 14px; padding-inline: 1.3rem; }
+}
+// A white card inside the body (forms), and numbered / titled sections.
+.fo-card { background: var(--fo-surface); border: 1px solid var(--fo-border); border-radius: 14px; padding: 1rem; }
+.fo-sec { border: 1px solid var(--fo-border); border-radius: 18px; background: var(--brand-98); padding: .9rem; }
+.fo-sec-head {
+  display: flex; align-items: center; gap: .75rem; padding: 0 .25rem .75rem;
+  > div { flex: 1; min-width: 0; }
+  h3 { margin: 0; font-size: 1rem; font-weight: 800; color: var(--fo-text); display: flex; align-items: center; gap: .5rem; }
+  h3 i { color: var(--brand-26); }
+  p { margin: .15rem 0 0; font-size: .8rem; color: var(--fo-muted); }
+  .num {
+    width: 30px; height: 30px; flex: none; border-radius: 50%; display: grid; place-items: center;
+    background: var(--brand-26); color: var(--white); font-weight: 800; font-size: .85rem;
+  }
+}
+// Read-only value tiles.
+.fo-details { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .75rem; }
+.fo-detail {
+  display: flex; flex-direction: column; gap: .25rem; min-width: 0;
+  padding: .75rem .9rem; border-radius: 12px; background: var(--fo-surface); border: 1px solid var(--fo-border);
+  &.full { grid-column: 1 / -1; }
+  small { color: var(--fo-muted); font-size: .75rem; }
+  b { color: var(--fo-text); font-weight: 700; overflow-wrap: anywhere; }
+}
+.fo-multiline { margin: 0; white-space: pre-line; color: var(--slate-27); line-height: 1.7; }
+.fo-muted { color: var(--fo-muted); }
+.fo-pill {
+  display: inline-flex; align-items: center; gap: .35rem; width: fit-content; padding: .25rem .7rem; border-radius: 999px;
+  font-size: .8rem; font-weight: 700; background: var(--brand-93); color: var(--brand-24);
+  &::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
+  &.off { background: var(--slate-95); color: var(--slate-44); }
+}
+.fo-audit { background: var(--slate-98); }
+// "Created by" table cell.
+.fo-created-by {
+  display: inline-flex; flex-direction: column; line-height: 1.3;
+  .who { font-weight: 600; color: var(--fo-text); }
+  .who.sys { color: var(--fo-muted); font-weight: 500; }
+  small { color: var(--fo-muted); font-size: .72rem; }
+}
+@media (max-width: 640px) {
+  .fo-dlg-head, .fo-dlg-body, .fo-dlg-foot { padding-inline: 1rem; }
+}
